# Placeholder settings for the image job in ci.yml, which runs the prod compose
# stack with the image it just built. None of these are real secrets.
IMAGE_TAG=ci
API_DOMAIN=localhost

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
REDIS_PASSWORD=ci

JWT_SECRET=ci-secret-at-least-32-bytes-long-0000
RESEND_API_KEY=ci
EMAIL_FROM=ci@example.com

S3_ENDPOINT_URL=http://localhost:1
S3_ACCESS_KEY_ID=ci
S3_SECRET_ACCESS_KEY=ci
S3_PUBLIC_BUCKET=ci-public
S3_PRIVATE_BUCKET=ci-private
S3_PUBLIC_BASE_URL=https://cdn.example.com
