# Environment: local or production
ENVIRONMENT=local
DEBUG=False
CORS_ORIGINS=["http://localhost:5173"]

# -- Postgres --------------------
# localhost for commands run on your machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# -- Database connection ---------
DATABASE_ENGINE_POOL_SIZE=
DATABASE_ENGINE_POOL_TIMEOUT=
DATABASE_ENGINE_POOL_RECYCLE=
DATABASE_ENGINE_POOL_PING=
DATABASE_ENGINE_MAX_OVERFLOW=
DATABASE_ENGINE_ECHO=

# -- Redis ----------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_INDEX=1

# -- Auth -----------------------
JWT_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
OTP_TTL=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# -- Email (Resend) -------------
RESEND_API_KEY=
EMAIL_FROM=

# -- Chat -----------------------
