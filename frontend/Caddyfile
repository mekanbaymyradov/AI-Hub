# Serves the built app. The edge Caddy in deploy/ handles TLS and the security
# headers.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	# A missing asset stays a 404, never index.html, so a bad build fails loudly.
	handle /assets/* {
		# Vite puts a content hash in these names, so a changed file gets a new
		# URL. Not on a 404, which a browser would then keep for a year.
		header Cache-Control "public, max-age=31536000, immutable" {
			match status 2xx
		}
		file_server
	}

	handle {
		# Revalidated on each load, so a release reaches returning visitors.
		header Cache-Control "no-cache"
		# BrowserRouter paths like /chats/<id> are index.html, routed in the browser.
		try_files {path} /index.html
		file_server
	}
}
